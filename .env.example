# --- Kandinsky API ------------------------------------------------------------
# Bearer-токен Kandinsky API. Обязателен. Не коммитить в git.
KANDINSKY_TOKEN=

# Хост API. По умолчанию — sberdevices; alternates см. docs/api-reference.md.
KANDINSKY_BASE_URL=https://kandinskyapi.sberdevices.ru

# --- Доступ к MCP-серверу -----------------------------------------------------
# Ключ, который агент присылает в заголовке X-API-Key (или как Bearer).
# Обязателен для HTTP-транспорта. Сгенерировать: openssl rand -hex 32
MCP_API_KEY=

# Секрет для подписи ссылок на файлы. Если пуст — берётся MCP_API_KEY.
# Настоятельно рекомендуется отдельный: ссылки живут дольше сессии.
FILE_SECRET=

# Базовый URL, по которому сервис виден снаружи: из него строятся ссылки на файлы.
PUBLIC_BASE_URL=https://kandinsky.example.com

# --- Транспорт ---------------------------------------------------------------
# http — постоянный сервис (по умолчанию), stdio — запуск агентом как подпроцесса.
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_PATH=/mcp

# Лимит тела запроса. base64 раздувает картинки на треть: 25 МБ → ~34 МБ JSON.
MCP_MAX_BODY_BYTES=41943040

# --- Хранилище и уборка -------------------------------------------------------
DATA_DIR=/data
RESULT_TTL_HOURS=168          # 7 дней
MAX_INLINE_BYTES=1500000      # картинки больше этого не встраиваются в ответ
FILE_URL_TTL_SECONDS=604800

# --- Поведение ---------------------------------------------------------------
HTTP_TIMEOUT=30
HTTP_DOWNLOAD_TIMEOUT=120
HTTP_MAX_ATTEMPTS=3

ROUTE_SYNC=true               # сверять реестр с openapi.json при старте
DEFAULT_CENSOR=true           # цензура включена (безопасный режим)
POLL_MIN_SECONDS=2
POLL_MAX_SECONDS=10
POLL_CONCURRENCY=8
RATE_LIMIT_PER_MINUTE=30

# Сколько секунд инструмент ждёт результат внутри вызова.
# Держите меньше таймаута вашего MCP-клиента: если клиент не дождётся ответа,
# он повторит вызов и создаст вторую платную генерацию.
DEFAULT_WAIT_SECONDS=25

# Окно защиты от повторов: одинаковый запрос в этом интервале возвращает
# уже созданную задачу, не тратя квоту. 0 — выключить.
DEDUPE_WINDOW_SECONDS=90

# Читать входные картинки с диска сервера. Включается автоматически в stdio.
ALLOW_LOCAL_PATHS=false

LOG_LEVEL=INFO
